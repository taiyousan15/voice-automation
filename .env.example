# ===== NewsData.io API =====
# 無料プラン: 2,000記事/日
# https://newsdata.io/
NEWSDATA_API_KEY=your_newsdata_api_key_here

# ===== Groq API (Primary LLM) =====
# 無料プラン: 制限あり
# https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ===== OpenRouter API (LLM Fallback) =====
# Claude Haiku経由
# https://openrouter.ai/
ANTHROPIC_API_KEY=your_openrouter_api_key_here
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
CLAUDE_MODEL=anthropic/claude-3-5-haiku
CLAUDE_MAX_TOKENS=4000

# ===== Fish Audio API (Primary TTS) =====
# https://fish.audio/
FISH_AUDIO_API_KEY=your_fish_audio_api_key_here
FISH_AUDIO_VOICE_ID=your_voice_id_here  # 必須: ユーザーが手動で指定

# ===== VOICEVOX (TTS Fallback) =====
# ローカル実行: http://localhost:50021
VOICEVOX_API_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=46

# ===== GitHub Pages =====
# RSS Feed公開用
GITHUB_PAGES_URL=https://username.github.io/repo-name

# ===== Optional: Advanced Settings =====
MIN_TRUST_SCORE=0.6
NEWSDATA_LANGUAGES=ja
NEWSDATA_COUNTRY=jp
NEWSDATA_SEARCH_LIMIT=10
