# Podcast Automation System - Environment Configuration
# Created: 2026-02-11
# Note: Copy this to .env and fill in actual values. NEVER commit .env to git

# ===== INFRASTRUCTURE =====
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===== DATABASE =====
DATABASE_URL=postgresql://podcast:podcast_pass@localhost:5432/podcast_automation
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ===== REDIS CACHE =====
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_HOURS=24

# ===== API KEYS - NewsData.io =====
NEWSDATA_API_KEY=your_newsdata_api_key_here
NEWSDATA_LANGUAGES=ja,en
NEWSDATA_SEARCH_LIMIT=10

# ===== API KEYS - Claude AI =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-haiku-20241022
CLAUDE_MAX_TOKENS=2000
CLAUDE_TIMEOUT_SECONDS=30

# ===== API KEYS - Groq (AI Fallback) =====
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15

# ===== TTS - ElevenLabs =====
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ===== TTS - VOICEVOX =====
VOICEVOX_ENABLED=true
VOICEVOX_API_URL=http://localhost:50021
VOICEVOX_SPEAKER_ID=3
VOICEVOX_SPEED_SCALE=1.0
VOICEVOX_PITCH_SCALE=0.0

# ===== DISTRIBUTION - Spotify =====
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# ===== DISTRIBUTION - YouTube =====
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# ===== DISTRIBUTION - Apple Podcasts =====
# Note: Apple Podcasts uses RSS feed, no API key needed
APPLE_PODCASTS_FEED_URL=https://your-domain.com/feeds/podcast.rss

# ===== DISTRIBUTION - stand.fm =====
# Note: stand.fm uses RSS feed only, no API key needed
STANDFM_RSS_FEED_URL=https://your-domain.com/feeds/podcast.rss
STANDFM_MANUAL_POST_ENABLED=true

# ===== DISTRIBUTION - note.com =====
# Note: note.com requires manual embedding, no API key needed
NOTECOM_MANUAL_POST_ENABLED=true
NOTECOM_ARTICLE_TEMPLATE_ID=your_template_id_here

# ===== SOCIAL MEDIA - Twitter/X =====
# Twitter/X Cookie認証（MCP対応）
# Format: "auth_token=<value>;ct0=<value>;twid=<value>"
TWITTER_COOKIES=auth_token=your_auth_token_here;ct0=your_ct0_here;twid=your_twid_here
TWITTER_AUTO_POST_ENABLED=true
TWITTER_HASHTAGS=#ポッドキャスト #AI #自動化
TWITTER_POST_DELAY_SECONDS=10  # 投稿間隔（Twitter API レート制限対策）

# ===== SOCIAL MEDIA - Other =====
# Optional: For additional social media integrations
LINKEDIN_API_KEY=your_linkedin_api_key_here
MASTODON_ACCESS_TOKEN=your_mastodon_token_here

# ===== SECURITY =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_HOURS=7
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ===== MONITORING =====
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3000

# ===== AWS / Object Storage =====
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET=podcast-audio-files
AWS_REGION=ap-northeast-1

# ===== SLACK NOTIFICATIONS (Optional) =====
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#podcast-ops
SLACK_NOTIFICATIONS_ENABLED=false

# ===== ADMIN CREDENTIALS =====
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_EMAIL=admin@podcast-automation.local

# ===== SCHEDULING =====
DAILY_EXECUTION_TIME=06:00  # JST 毎日朝6時実行
TIMEZONE=Asia/Tokyo

# ===== QUALITY THRESHOLDS =====
MIN_TRUST_SCORE=0.6  # 記事の信頼度スコアの最小値
MIN_SCRIPT_QUALITY=70  # 生成台本の最小品質スコア
MIN_AUDIO_QUALITY_BITRATE=128  # kbps
MAX_EPISODE_DURATION_MINUTES=60

# ===== LOGGING =====
LOG_FORMAT=json
LOG_OUTPUT=both  # console, file, both
LOG_RETENTION_DAYS=30
LOG_FILE_PATH=./logs/podcast-automation.log

# ===== DEVELOPMENT =====
MOCK_EXTERNAL_APIS=false
SKIP_TTS_GENERATION=false
DRY_RUN_MODE=false
